# ==============================================================================
# SignalStack GTM — Environment Configuration Example (No Credentials)
# ==============================================================================

# App Hosting
PORT=3000
APP_URL="http://localhost:3000"

# Database & Background Worker (for PostgreSQL / Redis deployments)
DATABASE_URL="postgresql://user:password@localhost:5432/signalstack"
REDIS_URL="redis://localhost:6379/0"
OBJECT_STORAGE_BUCKET="signalstack-exports"

# AI Model Providers (configure at least one via Secrets for live LLM parsing/drafting)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Core Integrations (Workspace-scoped server-side credentials)
APOLLO_API_KEY=""
HUNTER_API_KEY=""
HUBSPOT_ACCESS_TOKEN=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_CLIENT_SECRET=""
MICROSOFT_GRAPH_TENANT_ID="common"

# Optional Extended Integrations
CLAY_WEBHOOK_URL=""
CRUNCHBASE_API_KEY=""
BUILTWITH_API_KEY=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
META_LEAD_ADS_ACCESS_TOKEN=""
SLACK_BOT_TOKEN=""
